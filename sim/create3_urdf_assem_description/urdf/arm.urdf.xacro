<?xml version="1.0" ?>
<!--
  Arm + payload macro, grafted onto an existing robot (iRobot Create 3).

  Derived from create3_urdf_assem.xacro (SummerResearch2026) with:
    * the redundant `base_link` (Create 3 chassis) removed — iRobot's
      create3.urdf.xacro supplies base_link, wheels, sensors and plugins,
    * every joint renamed to drop spaces (ros2_control / gz / ros_gz_bridge
      cannot handle spaces in joint names),
    * the three payload chains that used to hang off `base_link`
      (arm tower, camera mount, basket) re-parented onto a single
      `arm_mount` frame, so only ONE transform (parent -> arm_mount) has to be
      tuned to place the whole payload on the Create 3,
    * the gripper 4-bar `mimic` joints restored.

  Usage (from a top-level xacro):
    <xacro:include filename="$(find create3_urdf_assem_description)/urdf/arm.urdf.xacro"/>
    <xacro:create3_arm parent="base_link">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:create3_arm>
-->
<robot name="create3_arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find create3_urdf_assem_description)/urdf/materials.xacro" />

  <!-- Gazebo converts package:// to model:// and only finds those meshes if
       GZ_SIM_RESOURCE_PATH is set before the server starts. RViz resolves
       package:// via ament, so use absolute file:// paths here for sim. -->
  <xacro:property name="mesh_dir"
                  value="file://$(find create3_urdf_assem_description)/meshes"/>

  <xacro:macro name="create3_arm" params="parent *origin">

    <!-- Single tunable mount frame. Everything below keeps its original
         fusion2urdf offsets, so only this joint's origin needs adjusting to
         seat the payload on the host robot's top plate. -->
    <link name="arm_mount">
      <inertial>
        <mass value="0.001"/>
        <inertia ixx="1e-6" ixy="0.0" ixz="0.0" iyy="1e-6" iyz="0.0" izz="1e-6"/>
      </inertial>
    </link>
    <joint name="arm_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="arm_mount"/>
    </joint>

    <!-- ==================== LINKS (no base_link) ==================== -->

    <link name="Basket_v13_1">
      <inertial>
    <origin xyz="-0.06000000000000006 -4.0407086268225834e-16 0.11140257124752022" rpy="0 0 0"/>
    <mass value="0.11499422004452"/>
    <inertia ixx="0.00043809225232158" iyy="0.000273236994506813" izz="0.000522589824382586" ixy="1.341438309011251e-18" iyz="-3.331954306378923e-18" ixz="-5.421010862427522e-19"/>
      </inertial>
      <visual>
    <origin xyz="-0.0 -0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="${mesh_dir}/Basket_v13_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="nylon_12_with_formlabs_fuse_1_3d_printer"/>
      </visual>
      <collision>
    <origin xyz="-0.0 -0.0 -0.0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="${mesh_dir}/Basket_v13_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
      </collision>
    </link>

