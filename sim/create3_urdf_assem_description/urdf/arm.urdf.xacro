    <mass value="1.33088698268545"/>
    <inertia ixx="0.0195508096535347" iyy="0.0194934024945922" izz="0.000871144215734764" ixy="4.67206117250925e-06" iyz="-4.80971973078023e-05" ixz="-0.0012636400237253"/>
