    <mass value="0.0152834381646124"/>
    <inertia ixx="3.79296716121122e-06" iyy="5.38017329065194e-06" izz="2.59536675226613e-06" ixy="1.091684495623316e-12" iyz="7.7084682724775e-07" ixz="-5.974396324881504e-12"/>
