    <link name="Base_v8_1">
      <inertial>
    <origin xyz="0.0003855517289991367 0.0027759063540528173 0.01918114147914035" rpy="0 0 0"/>
    <mass value="0.172135511489978"/>
    <inertia ixx="7.43707221079887e-05" iyy="7.65171561616373e-05" izz="0.000100049270469717" ixy="1.11277277933266e-07" iyz="2.44198108193525e-08" ixz="-5.13466019367703e-06"/>
