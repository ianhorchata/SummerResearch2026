    <!-- ==================== JOINTS ==================== -->

    <!-- Payload roots: originally parented to base_link, now on arm_mount. -->

    <joint name="basket_fixed" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <parent link="arm_mount"/>
      <child link="Basket_v13_1"/>
    </joint>

    <joint name="arm_tower_fixed" type="fixed">
      <origin xyz="0.084 0.0 0.0936" rpy="0 0 0"/>
      <parent link="arm_mount"/>
      <child link="ArmAssem-LowTorque_v22_1"/>
    </joint>

    <joint name="camera_mount_fixed" type="fixed">
      <origin xyz="0.0 0.0 0.0" rpy="0 0 0"/>
      <parent link="arm_mount"/>
      <child link="CameraMount_v13_1"/>
    </joint>

    <!-- Arm joint 1 (was Servo1) -->

    <joint name="arm_joint_1" type="revolute">
      <origin xyz="0.018763 0.0265 0.0269" rpy="0 0 0"/>
      <parent link="ArmAssem-LowTorque_v22_1"/>
      <child link="ArmLink_Assem_v2_1"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit upper="2.094395" lower="-2.094395" effort="100" velocity="100"/>
    </joint>

    <!-- Arm joint 2 (was Servo2) -->

    <joint name="arm_joint_2" type="revolute">
      <origin xyz="0.0 5e-05 0.128317" rpy="0 0 0"/>
      <parent link="ArmLink_Assem_v2_1"/>
      <child link="ArmLink_Assem_v2_2"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit upper="2.094395" lower="-2.094395" effort="100" velocity="100"/>
    </joint>

    <!-- Arm joint 3 (was Servo3) -->

    <joint name="arm_joint_3" type="revolute">
      <origin xyz="0.0 5e-05 0.128317" rpy="0 0 0"/>
      <parent link="ArmLink_Assem_v2_2"/>
      <child link="RDS3225_-_for_URDF_v5_1"/>
      <axis xyz="0.0 1.0 0.0"/>
      <limit upper="2.094395" lower="-2.094395" effort="100" velocity="100"/>
    </joint>

    <joint name="gripper_base_fixed" type="fixed">
      <origin xyz="0.0 -0.02715 0.037917" rpy="0 0 0"/>
      <parent link="RDS3225_-_for_URDF_v5_1"/>
      <child link="Base_v8_1"/>
    </joint>

    <!-- Gripper driver (was Servo4). Actuated joint. -->

    <joint name="gripper_joint" type="revolute">
      <origin xyz="0.026307 0.0124 0.023" rpy="0 0 0"/>
      <parent link="Base_v8_1"/>
      <child link="DriverArm_v2_1"/>
      <axis xyz="1.0 -1e-06 -1e-06"/>
      <limit upper="1.2" lower="-1.2" effort="20" velocity="10"/>
    </joint>

    <!-- Gripper 4-bar passive joints mimic gripper_joint (from create3.xacro).
         Multipliers: passive_1=+1, passive_2=+1, passive_3=-1, passive_4=-1, passive_5=+1 -->

    <joint name="gripper_passive_1" type="revolute">
      <origin xyz="0.025918 -0.012 0.02305" rpy="0 0 0"/>
      <parent link="Base_v8_1"/>
      <child link="DrivenArm_v2_1"/>
      <axis xyz="-1.0 0.0 1e-06"/>
      <limit upper="1.2" lower="-1.2" effort="20" velocity="10"/>
      <mimic joint="gripper_joint" multiplier="1" offset="0"/>
    </joint>

    <joint name="gripper_passive_2" type="revolute">
      <origin xyz="0.025918 -0.004346 0.042352" rpy="0 0 0"/>
      <parent link="Base_v8_1"/>
      <child link="FrontArmLeft_v2_1"/>
      <axis xyz="-1.0 0.0 1e-06"/>
      <limit upper="1.2" lower="-1.2" effort="20" velocity="10"/>
      <mimic joint="gripper_joint" multiplier="1" offset="0"/>
    </joint>

    <joint name="gripper_passive_3" type="revolute">
      <origin xyz="0.025918 0.00475 0.042352" rpy="0 0 0"/>
      <parent link="Base_v8_1"/>
      <child link="FrontArmRight_v2_1"/>
      <axis xyz="-1.0 0.0 1e-06"/>
      <limit upper="1.2" lower="-1.2" effort="20" velocity="10"/>
      <mimic joint="gripper_joint" multiplier="-1" offset="0"/>
    </joint>

    <joint name="gripper_passive_4" type="revolute">
      <origin xyz="0.016 0.0 0.042585" rpy="0 0 0"/>
      <parent link="DrivenArm_v2_1"/>
      <child link="LeftPad_v2_1"/>
      <axis xyz="-1.0 -0.0 1e-06"/>
      <limit upper="1.2" lower="-1.2" effort="20" velocity="10"/>
      <mimic joint="gripper_joint" multiplier="-1" offset="0"/>
    </joint>

    <joint name="gripper_passive_5" type="revolute">
      <origin xyz="0.016 4e-06 0.042585" rpy="0 0 0"/>
      <parent link="DriverArm_v2_1"/>
      <child link="RightPad_v2_1"/>
      <axis xyz="-1.0 1e-06 1e-06"/>
      <limit upper="1.2" lower="-1.2" effort="20" velocity="10"/>
      <mimic joint="gripper_joint" multiplier="1" offset="0"/>
    </joint>

  </xacro:macro>
</robot>
