    <mass value="0.0791893057217848"/>
    <inertia ixx="2.82106812690159e-05" iyy="1.58164077691345e-05" izz="1.74398753985518e-05" ixy="2.415999719629328e-11" iyz="4.12347903638314e-07" ixz="-5.356776524093054e-11"/>
