<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robot_bringup</name>
  <version>0.1.0</version>
  <description>Top-level launch files that start the whole robot (arm + cameras).</description>
  <maintainer email="horchi@lafayette.edu">i-horch</maintainer>
  <url type="website">https://github.com/i-horch</url>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_arm</exec_depend>
  <exec_depend>robot_vision</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- gscam2 publishes the CSI cameras; install it or build from source.
       See README. -->
  <exec_depend>gscam2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
